#!/usr/bin/env python3
"""Set, or check, the release version across every file that carries it.

Four values in three files have to agree or a release fails its version gate:

  package.json                              the catalog image version
  pkg/remuda/package.json                   the extension chart's version
  deploy/chart/remuda-controller/Chart.yaml version and appVersion

    scripts/bump-version 0.2.0            set them all
    scripts/bump-version --check          verify they agree with each other
    scripts/bump-version --check 0.2.0    verify they all equal 0.2.0
    scripts/bump-version --sync --stage   copy the root package.json version to
                                          the rest and git-add what changed

`--sync` is what `yarn version` calls: yarn bumps the root package.json itself,
then runs the `version` lifecycle script before committing, so this brings the
other files into line and stages them into the same commit. `--stage` adds
exactly the files this script writes, so nothing else in a dirty tree gets swept
into a release commit.

`--check` exists so CI can enforce this with the *same* list of files the bump
uses. When the check lived separately in workflow YAML, the two could disagree
about what carries a version -- and the only signal was a failed release.

Without a version argument it checks the files against each other, which is what
CI runs on every push. That turns a hand-edited version into a failure on the
commit that caused it, rather than on the tag days later -- which is exactly how
0.1.2 shipped a mismatched controller chart.
"""

import json
import re
import subprocess
import sys
from collections import OrderedDict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CHART = ROOT / 'deploy/chart/remuda-controller/Chart.yaml'
PACKAGES = [ROOT / 'package.json', ROOT / 'pkg/remuda/package.json']

SEMVER = re.compile(r'^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$')


def package_version(path):
    return json.loads(path.read_text()).get('version')


def chart_versions(path):
    text = path.read_text()
    version = re.search(r'^version:\s*(\S+)', text, re.M)
    app = re.search(r'^appVersion:\s*"?([^"\s]+)"?', text, re.M)

    return (version.group(1) if version else None, app.group(1) if app else None)


def current():
    """Every version-carrying value, as (label, value) pairs."""
    out = [(str(p.relative_to(ROOT)), package_version(p)) for p in PACKAGES]
    version, app = chart_versions(CHART)
    label = str(CHART.relative_to(ROOT))
    out += [(f'{ label } version', version), (f'{ label } appVersion', app)]

    return out


def set_package_version(path, version):
    data = json.loads(path.read_text(), object_pairs_hook=OrderedDict)
    data['version'] = version
    path.write_text(json.dumps(data, indent=2) + '\n')


def set_chart_version(path, version):
    text = path.read_text()

    # Rewritten line-wise rather than through a YAML round-trip, to keep the
    # file's comments and key ordering exactly as they are.
    text = re.sub(r'^version:.*$', f'version: { version }', text, count=1, flags=re.M)
    text = re.sub(r'^appVersion:.*$', f'appVersion: "{ version }"', text, count=1, flags=re.M)
    path.write_text(text)


def check(version=None):
    values = current()

    if version is None:
        # No target given: the extension package is the reference, since its
        # version is what the release tag has to match.
        version = dict(values)['pkg/remuda/package.json']

    bad = [(label, value) for label, value in values if value != version]

    for label, value in bad:
        # GitHub Actions renders this as an annotation on the failing step.
        print(f'::error::{ label } is { value }, expected { version }. Run scripts/bump-version { version }')

    if bad:
        return 1

    print(f'All { len(values) } version values agree on { version }')

    return 0


def apply(version, stage=False, advise=True):
    before = dict(current())

    for path in PACKAGES:
        set_package_version(path, version)

    set_chart_version(CHART, version)

    for label, value in current():
        print(f'  { label }: { before.get(label) } -> { value }')

    if stage:
        # Only the files this script writes. `git add -A` here would sweep any
        # unrelated work in the tree into the release commit.
        subprocess.run(['git', 'add', *[str(p) for p in [*PACKAGES, CHART]]], cwd=ROOT, check=True)
        print('  staged')

    if advise:
        print(f"""
Next:

  git commit -am 'Release { version }'
  git tag v{ version } && git push && git push --tags""")

    return 0


def main():
    args = sys.argv[1:]
    checking = '--check' in args
    syncing = '--sync' in args
    staging = '--stage' in args

    for flag in ('--check', '--sync', '--stage'):
        while flag in args:
            args.remove(flag)

    if syncing:
        # yarn has already written the new version into the root package.json.
        version = package_version(PACKAGES[0])
        sys.exit(apply(version, stage=staging, advise=False))

    if checking and not args:
        sys.exit(check())

    if len(args) != 1:
        sys.exit(f'usage: { sys.argv[0] } [--check] [<version>]    e.g. { sys.argv[0] } 0.2.0')

    version = args[0].lstrip('v')

    if not SEMVER.match(version):
        sys.exit(f"'{ version }' is not X.Y.Z")

    sys.exit(check(version) if checking else apply(version, stage=staging))


if __name__ == '__main__':
    main()
